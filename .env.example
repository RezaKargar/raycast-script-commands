# Copy to .env and fill in. .env is git-ignored.

# Optional: your environments, comma-separated. Each NAME below stands for one of them, and it is
# shown lowercased in Raycast. Defaults to PROD,STAGE,DEMO.
# K8S_ENVIRONMENTS=PROD,STAGE,DEMO

# kubectl context per environment (see `kubectl config get-contexts`). An environment without one
# is skipped.
K8S_CONTEXT_PROD=
K8S_CONTEXT_STAGE=
K8S_CONTEXT_DEMO=

# Namespace for all environments; K8S_NAMESPACE_<NAME> overrides it for one.
K8S_NAMESPACE=
# K8S_NAMESPACE_DEMO=

# Secret Last Changed: the Secret to check per environment.
K8S_SECRET_PROD=
K8S_SECRET_STAGE=
K8S_SECRET_DEMO=
# Optional: K8S_SECRET_<NAME>_FALLBACK is shown instead while that Secret does not exist yet.
# K8S_SECRET_PROD_FALLBACK=

# Canary Status: the Argo Rollout to check per environment (a Deployment of that name works too,
# shown without a canary).
K8S_ROLLOUT_PROD=
K8S_ROLLOUT_STAGE=
K8S_ROLLOUT_DEMO=

# Optional: also read each new pod's own error counts, if your app serves them on a private port
# at /errorz (see the README for the format). Left unset, Canary Status skips this.
# CANARY_ERRORZ_PORT=
# With their defaults: a pod fails above this error ratio, once it has served this many requests.
# CANARY_MAX_ERROR_RATIO=0.02
# CANARY_MIN_REQUESTS_PROD=100
