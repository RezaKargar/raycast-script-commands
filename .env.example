# Copy to .env and fill in. .env is git-ignored.

# Kubernetes namespace the Kubernetes Checks extension looks in.
K8S_NAMESPACE=

# kubectl contexts per environment (see `kubectl config get-contexts`).
K8S_CONTEXT_PROD=
K8S_CONTEXT_STAGE=
K8S_CONTEXT_DEMO=

# Secret Last Changed: the Secret to check per environment.
K8S_SECRET_PROD=
K8S_SECRET_STAGE=
K8S_SECRET_DEMO=
# Optional: shown instead while K8S_SECRET_PROD does not exist yet.
K8S_SECRET_PROD_FALLBACK=

# Canary Status: the Argo Rollout to check per environment.
K8S_ROLLOUT_PROD=
K8S_ROLLOUT_STAGE=
K8S_ROLLOUT_DEMO=
# Optional, with their defaults: the pods' private /errorz port, and the analysis thresholds
# (fails above this error ratio, once a pod has at least this many requests).
CANARY_ERRORZ_PORT=8081
CANARY_MAX_ERROR_RATIO=0.02
CANARY_MIN_REQUESTS_PROD=100
CANARY_MIN_REQUESTS_STAGE=100
CANARY_MIN_REQUESTS_DEMO=100
